{
  "name": "rbo",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema de gestión de finanzas personales RBO.",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "concurrently \"npm run tailwind\" \"npm run server\"",
    "server": "node --watch app.js",
    "tailwind": "npx @tailwindcss/cli -i ./src/global.css -o ./src/app/output.css --watch"
  },
  "keywords": [
    "finanzas",
    "dashboard",
    "express"
  ],
  "author": "Bryant",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bafaf23/RBO.git"
  }
}